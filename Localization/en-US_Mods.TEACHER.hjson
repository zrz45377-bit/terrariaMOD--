# This file will automatically update with entries for new content after a build and reload.

Items: {
	BASIS: {
		DisplayName: 噩梦构造体
		Tooltip:
			'''
			凝聚梦魇本源的巨大魔球，以毁灭之姿撕裂现实
			贯穿万物——敌人、玩家、乃至空间本身，触壁即反，永不停歇
			二十秒后，它将耗尽所有理智，化作湮灭一切的终焉大爆炸
			"太极生两仪，两仪生四象，四象生八卦，八卦生——轰！！！"
			'''
	}

	Start: {
		DisplayName: 馬鹿の徽章
		Tooltip:
			'''
			传说中那位以⑨之名震碎梦魇巫女的勇者所遗落的圣徽
			佩戴者的思维将升华至绝对零度的清醒——自动索敌，无处可逃
			"冰之勇者？？琪露诺,别傻了！快醒过来"
			'''
	}

	Gun: {
		DisplayName: 废弃的配枪
		Tooltip: '''"似乎是月都最强者废弃的配枪，枪管里还回荡着足以撕裂神智的狂气"'''
	}

	SentryOverlord: {
		DisplayName: 腐烂的叶子
		Tooltip:
			'''
			作为代价，近战、远程与魔法的威能被大幅压制，唯有召唤之力获得妖异的增幅
			"仔细看，每片叶子的末端都拖着一条狸尾"
			'''
	}

	GlassCannonEmblem: {
		DisplayName: 黑暗的余烬魔法瓶
		Tooltip:
			'''
			"乐园的普通魔法使所酿造的究极禁药——八倍蘑菇精华浓缩！"
			"只要火力够猛，就算是那操纵命运的硫磺魔女，也给我轰成星尘——大概吧，DAZE！"
			'''
	}

	IbukiGourd: {
		DisplayName: 褪色的酒壶
		Tooltip:
			'''
			褪色的酒壶里面似乎可以道出无无限清酒
			远程、魔法与召唤的威能被醉意彻底压制
			移动速度失控
			'''
	}

	LunarLostEye: {
		DisplayName: 遗落之眼
		Tooltip:
			'''
			远程伤害提升20%，远程暴击率提升12%，移动速度提升10%
			"可能是月面战场上被遗弃的兔之眼珠，本该死去，却仍在转动"
			'''
	}

	MiniHakkero: {
		DisplayName: 废弃的棱镜
		Tooltip:
			'''
			按住蓄力，将爱、勇气与不要命的魔力一同填装——
			蓄力未满便松手？魔导器将直接熄火，留下一声嘲笑
			'''
	}

	TorchGodsFavor_item: {
		DisplayName: 古神火种的余烬
		Tooltip:
			'''
			放置火把的速度获得神谕级增幅，凡火自动蜕变为对应环境的禁忌圣火
			若你胆敢踏入绝对黑暗超过3秒，七色净火将从你骨髓中燃起，照亮你的罪
			"凡人，你已在深渊点燃了第101支火把，获得了觐见火源的资格"
			"记住——当最后一支火把熄灭，古神将从灰烬中睁开祂的千目，世界重归初燃的混沌"
			'''
	}

	NightmareStaff: {
		DisplayName: 噩梦大杖
		Tooltip:
			'''
			左键释放，右键轮回切换七种模式
			传送模式下，左键即是无代价、无冷却、无混沌状态的绝对瞬移
			"将六色宝石的魔导力与无间妖王的禁忌法则强行熔铸的造物，持杖者终将成为噩梦的代行者"
			'''
	}

	StrangeHat: {
		DisplayName: 遗落的帽子
		Tooltip:
			'''
			不知从哪个被诅咒的垃圾桶深处拾得
			无法否认，这顶帽子上浸透了天狗的狂风与狼灵的霜雪之息
			'''
	}

	GungnirSpear: {
		DisplayName: 生锈的长枪
		Tooltip: 掷出的长矛将化作血月，命中的刹那即引爆不可逃避的宿命审判
	}

	ShionYorigami: {
		DisplayName: 废弃的碗
		Tooltip:
			'''
			"贫穷，饥饿与你同行..."
			等等里面有一个FUMO
			'''
	}

	DugOutEye: {
		DisplayName: 被挖下来的眼睛
		Tooltip:
			'''
			间歇性使附近敌人陷入混乱
			"这个惶恐不安的眼睛，在离开了地灵殿后变得极其疯狂"
			'''
	}

	SunWormHelmet: {
		DisplayName: 死去枯萎的太阳虫
		Tooltip:
			'''
			伊札里斯的寄生虫，完全不动，却依然活着
			戴在头上时会发出炫目的光，吞噬一切黑暗
			'我的太阳落山了……'
			'''
	}

	Humanity: {
		DisplayName: 人性
		Tooltip: 从生灵中剥离的意志残渣。微弱的光芒中似乎还残留着某种情感。
	}

	WallOfFleshSummon: {
		DisplayName: 血水晶
		Tooltip:
			'''
			向导的灵魂封印于人偶之中。
			在地狱深处使用，可替代向导唤醒血肉之墙。
			'''
	}

	SkeletronSummon: {
		DisplayName: 失落之书
		Tooltip:
			'''
			将缠绕服装商的古老诅咒转移至人偶。
			诅咒可以转移，但永远不会消失——它只是换了一个容器。
			'''
	}

	PlanteraSummon: {
		DisplayName: 被唤醒的花种
		Tooltip: 以人性与灵气灌溉的禁忌花种，根须已在黑暗中饥渴了数百年。
	}

	ShinkiTome: {
		DisplayName: 废弃的神造魔导书
		Tooltip:
			'''
				一个废弃的书本，曾经 骄傲的魔界创世神 赐予最得意的高等造物 
				但是 在整个魔界与 骑在玄武上面的巫女战斗过后
				废弃且不知所踪
				"上面有 爱丽丝 的签名"
			'''
	}
}

NPCs: {
	M.DisplayName: 遗落者

	Evil: {
		DisplayName: 噩梦守卫的阴阳玉
		Bestiary:
			'''
			从被撕裂的梦境深渊中缓缓浮出的远古处刑者。
			它本为镇压无尽噩梦而铸，却在亿万次轮回侵蚀中，成为了噩梦的化身与守门人。
			巨大的阴阳玉在其周身永无止境地旋转，所过之处，现实与虚幻的边界被彻底抹除，化为混沌的夹缝。
			任何妄图以弹幕挑战它的愚蠢之人，都将亲眼见证自己的攻击湮灭于虚无，随后——自身亦然。
			'''

		DeathText: {
			Generic: "{0} 被噩梦守卫的阴阳玉碾成了连尘埃都不剩下的虚无。"
			Generic2: "{0} 试图用弹幕对抗噩梦守卫，然后发现自己的攻击和存在一起归于了虚无。"
		}
	}

	ChestMimic: {
		DisplayName: 遗落的军械箱
		Bestiary:
			'''
			从某个被神明遗弃的覆灭古国废墟中苏醒的活体兵器库。
			它不渴求黄金，不垂涎珠宝，只贪婪地吞噬世间一切沾染过鲜血的武器与战具。
			越是经历过尸山血海的冒险者，越能唤醒它深处沉睡的"饥饿记忆"——
			然后，成为它收藏中最新的"展品"。
			'''

		DeathText: {
			Generic: "{0} 被遗落的军械箱吞进了没有尽头的兵器深渊，连骨头都被锻成了铁渣。"
			Generic2: "{0} 满怀期待地打开了箱子，结果箱子也满怀期待地吃掉了{0}。"
		}
	}

	TorchGodsFavor: {
		DisplayName: 火把古神
		Bestiary: 自地心初燃之时便镇守火源秩序的远古神祇。凡人以千百支火把将地下化为白昼，此举被祂视为对黑暗原典的亵渎与宣战。当第101支火把点亮深渊，古神便会凝聚焚世形体，以七色净火重塑地底的法则——烧尽一切僭越之光。

		DeathText: {
			Generic: "{0} 点燃了第101支火把，古神的七色净火将{0}从灵魂到肉体焚至连灰烬都不剩。"
			Generic2: "{0} 在绝对黑暗中逗留太久，古神的注视如同超新星爆发，将{0}烧成了宇宙尘埃。"
		}
	}

	MineralSlimeM3: {
		DisplayName: 飞行矿物史莱姆
		Bestiary:
			'''
			地底深处浓郁到结晶化的矿物魔力与史莱姆凝胶发生了禁忌的融合。
			不同个体因吞噬的矿石种类各异，进化出了截然不同的杀戮方式：有的投掷岩块如暴雨倾盆，有的分裂子体如瘟疫蔓延，有的则像喝了假酒的鬼王般横冲直撞，碾碎一切。
			其透明的凝胶体内可见闪烁的高纯度结晶，对冒险者而言，这既是移动的死亡陷阱，也是流淌着财富的活体矿脉。
			"明明是史莱姆为什么会飞？——地灵殿那位嫉妒怪看了都要嫉妒到发狂DAZE！"
			'''

		DeathText: {
			Generic: "{0} 被飞行矿物史莱姆的结晶弹幕轰成了血肉筛子。"
			Generic2: "{0} 试图采集这只史莱姆，结果反被它采集了生命。"
		}
	}

	RemiliaBat: {
		DisplayName: 红魔蝙蝠
		Bestiary: 栖息于永恒猩红之夜的幽灵血兽，以强者的鲜血为食，愈战愈狂，愈伤愈强。据说其真身并非蝙蝠，不过是那位绯红恶魔投下的、微不足道的影子罢了——即便如此，也足以撕碎凡人。

		DeathText: {
			Generic: "{0} 被一只蝙蝠单杀了，这丢人程度足以名留青史。"
			Generic2: "{0} 现在明白为什么那位大小姐从不出门了——她的宠物蝙蝠就能搞定一切杂鱼。"
		}
	}

	YoumuHalfSpiritTrader: {
		DisplayName: 死欲的半灵
		Bestiary:
			'''
			是生是死，是人非人，连她自己也早已模糊了这个边界。
			这具饥饿的恐怖半灵渴望吞噬巨量生灵，然后在黎明前返回那遥远的冥界，
			去侍奉那位令人战栗的、带来永恒死亡的【华胥的亡灵】——
			而你，或许就是她的"祭品"或"夜宵"。
			'''

		DeathText: {
			Generic: "{0} 被饥饿的大小姐当成了今夜的夜宵，连骨头都没剩下。"
			Generic2: "{0} 在半灵消散的血雾中，听到了妖梦拔剑的死亡之音。"
		}
	}

	ResurrectionButterflyBlue: {
		DisplayName: 死蝶·苍
		Bestiary:
			'''
			从幽幽子大小姐的符卡「反魂蝶」中逃逸的一抹苍蓝残影。
			本应在无尽弹幕中消逝的磷光，却因半灵分身携带的浓郁冥界气息而滞留现世，成为了规则的漏洞。
			它的翅翼褪去了所有生者的色彩，只剩无名的死灰，唯有在靠近半灵时才会被染成幽冷的苍蓝——那是冥河的颜色。
			据说触碰过它的人，会短暂看见白玉楼庭院中永不凋谢的樱花——然后永远忘记自己为何流泪，也忘记自己是谁。
			'''

		DeathText: {
			Generic: "{0} 被返魂蝶的苍蓝磷光引渡，踏上了前往冥界的单程旅途。"
			Generic2: "{0} 试图触碰那抹苍蓝，却发现自己早已失去了可以触碰它的手——以及身体。"
		}
	}

	ResurrectionButterflyPurple: {
		DisplayName: 死蝶·紫
		Bestiary:
			'''
			从幽幽子大小姐的符卡「反魂蝶」中逃逸的一缕紫幻幽火。
			与苍蓝蝶成双成对，环绕着半灵分身翩翩起舞，仿佛在为下一个迷失的亡魂铺设黄泉路。
			灰色的翅翼本身并无颜色，直到它开始贪婪地吸食半灵溢出的灵力，才泛起妖艳而致命的紫芒。
			白玉楼的仆从们深知，紫蝶出现的地方，意味着大小姐的夜宵正在路上——或者，有人即将成为那道夜宵。
			'''

		DeathText: {
			Generic: "{0} 被返魂蝶的紫色磷火带往了华胥之国，再也没有回来。"
			Generic2: "{0} 沉醉于那妖艳的紫色光芒，再次醒来时，已是白玉楼庭前一株无名的枯樱。"
		}
	}

	FireflyMerchant: {
		DisplayName: 蠕动夜虫
		Bestiary: 夏夜深处现身的萤火虫妖怪，自号"蠕动夜虫"。她是吞噬蜗牛不眨眼的昆虫之主，虫群的女王。若你携带了足够多的蜗牛献祭，她或许会大发慈悲，分享自己捕获的稀世怪虫——但记住，她的心情和虫群一样变幻莫测。

		DeathText: {
			Generic: "{0} 被莉格露的狂怒虫群啃噬殆尽，连渣都没剩下。"
			Generic2: "{0} 胆敢抢夺莉格露的蜗牛，结果被夜虫之怒烧成了连灰烬都算不上的虚无。"
		}

		TownNPCMood: {
			Content: 我很满足，虫群也很安静。
			NoHome: 我讨厌没有巢穴的日子，虫群在躁动。
			FarFromHome: 我离巢穴太远了，这很危险。
			LoveSpace: 我非常喜欢有这么大的空间，虫群可以尽情繁衍。
			DislikeCrowded: 我不喜欢这么拥挤，虫群需要呼吸的空间。
			HateCrowded: 我讨厌这么拥挤，虫群要暴走了！
			LikeNPC_Princess: 我喜欢 {NPCName}，她身上有光。
			Princess_LovesNPC: 我喜欢 {NPCName}，虫群也喜欢你。
		}
	}

	FlandreEliteBat: {
		DisplayName: 蝠兰
		Bestiary:
			'''
			从红魔馆最深处的封印中渗漏而出的一缕狂气。
			它并非蝙蝠，而是那位被囚禁了495年的破坏之翼——溢出的、无法被牢笼与法则束缚的杀意本身。
			血月或南瓜月升起之时，它便遵循最原始的破坏冲动：先将目之所及的城镇屠戮殆尽，再向最后的幸存者展露獠牙。
			据说它唯一的温柔，全都留给了布丁。
			'''

		DeathText: {
			Generic: "{0} 被狂蝠当成了布丁上的樱桃，一口嚼碎，连模具都省了。"
			Generic2: "{0} 的城镇NPC朋友们先走了一步，现在{0}也追上去了——以布丁馅料的形式。"
		}
	}

	DespairEye.DisplayName: 绝望之眼
}

Projectiles: {
	Ice.DisplayName: 绝对零度·雪花
	Button.DisplayName: 死亡准心
	YinYangOrb.DisplayName: 湮灭噩梦球
	MyLaserBeam.DisplayName: 贯穿魔炮
	GungnirThrownProj.DisplayName: 猩红血月
	GungnirMeleeProj.DisplayName: 绯红雾霭
	ShionYorigamiPet.DisplayName: 紫苑FUMO
}

Currency.Snail: 蜗牛（莉格露的硬通货）

Buffs: {
	ShionYorigamiBuff: {
		DisplayName: 紫苑FUMO？？
		Description:
			'''
			最凶最恶的贫穷神千分之一的意志与你同行
			你会死无葬身之地
			'''
	}
}

Configs: {
	TEACHERConfig: {
		DisplayName: 随机掉落怪生成调整
		Headers.危险功能: 危险功能 Header

		EnableRandomDropSpawner: {
			Label: 启用随机掉落怪生成
			Tooltip:
				'''
				开启后，'遗落者'将在夜晚的地表自然生成。
				击杀后会从全游戏物品池里随机掉落物品。
				警告：可能导致存档混乱或获得异常物品，后果自负！
				'''
		}
	}
}
